{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"theoses-telemetry": ["./packages/telemetry/src/index.ts"],
			"theoses-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"theoses-ai": ["./packages/ai/src/index.ts"],
			"theoses-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"theoses-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"theoses-ai/dist/*": ["./packages/ai/src/*"],
			"theoses-agent-core": ["./packages/agent/src/index.ts"],
			"theoses-agent-core/*": ["./packages/agent/src/*"],
			"theoses-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"theoses-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"theoses-coding-agent/*": ["./packages/coding-agent/src/*"],
			"theoses-protocol": ["./packages/protocol/src/index.ts"],
			"theoses-protocol/*": ["./packages/protocol/src/*"],
			"theoses-client": ["./packages/client/src/index.ts"],
			"theoses-client/*": ["./packages/client/src/*"],
			"theoses-server": ["./packages/server/src/index.ts"],
			"theoses-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"theoses-tui": ["./packages/tui/src/index.ts"],
			"theoses-tui/*": ["./packages/tui/src/*"],
			"theoses-agent-old": ["./packages/agent-old/src/index.ts"],
			"theoses-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
