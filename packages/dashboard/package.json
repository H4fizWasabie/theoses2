{
	"name": "theoses-dashboard",
	"version": "1.0.16",
	"description": "Private browser dashboard for Theoses",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsgo -p tsconfig.json && shx rm -rf dist/public && shx cp -r src/public dist/public",
		"test": "node --experimental-strip-types --test test/*.test.ts"
	},
	"dependencies": {
		"theoses-coding-agent": "^1.0.16"
	},
	"devDependencies": {
		"shx": "0.4.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
