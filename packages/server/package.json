{
	"name": "theoses-server",
	"version": "1.0.20",
	"description": "experimental server package for pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"theoses",
		"server"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/H4fizWasabie/theoses2.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"theoses-ai": "^1.0.20",
		"theoses-protocol": "^1.0.20"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
